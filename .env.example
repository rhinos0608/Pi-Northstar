# Pi-Northstar environment variables
# Copy to .env or set in your shell profile (~/.zshrc, ~/.bashrc)
# Process environment wins over .env

# ── API keys (optional — zero-config DuckDuckGo works without any) ──

# GITHUB_TOKEN="ghp_..."
# EXA_API_KEY="..."
# BRAVE_API_KEY="..."
# TAVILY_API_KEY="..."
# YOUTUBE_API_KEY="..."
# REDDIT_CLIENT_ID="..."
# REDDIT_CLIENT_SECRET="..."
# REDDIT_USER_AGENT="pi-northstar/0.1"
# SEARXNG_BASE_URL="https://searxng.example.com"
# NITTER_BASE_URL="https://nitter.example.com"
# LISTENNOTES_API_KEY="..."
# PRODUCTHUNT_API_TOKEN="..."
# PATENTSVIEW_API_KEY="..."

# ── Research source keys (optional; Pi conventions, not vendor-standard names) ──
# All research sources work unauthenticated; these keys only raise quota limits.
# SEMANTIC_SCHOLAR_API_KEY="..."
# OPENALEX_API_KEY="..."
# NCBI_API_KEY="..."        # PubMed E-utilities optional key
# NCBI_EMAIL="you@example.com"
# STACKEXCHANGE_KEY="..."

# ── Diffbot (optional, paid — read README privacy warning first) ──
# Setting DIFFBOT_TOKEN sends queries, URLs, selectors, and text to Diffbot endpoints.
# Operator limits are defaults/caps: resolveDiffbotSpend validates once per kg call
# and rejects out-of-range before any paid call (never clamps).
# No behavior changes without DIFFBOT_TOKEN.
# DIFFBOT_TOKEN="..."
# DIFFBOT_SEARCH_SIZE="10"        # default 10, max 50 per provider
# DIFFBOT_ENHANCE_SIZE="1"        # default 1, max 10 per provider
# DIFFBOT_NLP_MAX_CHARS="100000"  # hard cap 100000
# DIFFBOT_MAX_PROVIDERS="3"       # default 3, max 8
# DIFFBOT_FALLBACK_BUDGET="3"     # default 3, max 25 per fetch, 0 disables

# ── Firecrawl + Jina (optional, paid/external — read README privacy warning first) ──
# Setting these keys sends queries/URLs to fixed vendor hosts only, plus
# vendor-side external processing of page reads. No cookies, browser state,
# or caller headers are forwarded. Selection/AI controls below stay env-only.
# FIRECRAWL_API_KEY="..."
# JINA_API_KEY="..."

# ── Extended web search providers (optional, paid/external — read README privacy warning first) ──
# Each key enables its backend for explicit PI_SEARCH_WEB_BACKENDS lists only;
# none join the automatic top-3 preference order. Selection stays env-only.
# Credential requirements vary by provider: most need only their API key, but
# Bright Data needs BOTH BRIGHTDATA_API_KEY and BRIGHTDATA_SERP_ZONE.
# PARALLEL_API_KEY="..."
# TINYFISH_API_KEY="..."
# QUERIT_API_KEY="..."
# VALYU_API_KEY="..."
# BOCHA_API_KEY="..."
# XCRAWL_API_KEY="..."
# XAI_API_KEY="..."
# MISTRAL_API_KEY="..."
# BRIGHTDATA_API_KEY="..."
# BRIGHTDATA_SERP_ZONE="..."  # required together with BRIGHTDATA_API_KEY
# SERPAPI_KEY="..."
# SERPER_API_KEY="..."

# ── Web search selection + native AI + fetch routing (env-only, no JSON mapping) ──
# Absent/blank PI_SEARCH_WEB_BACKENDS selects the first 3 configured backends in
# preference order (tavily, exa, brave, diffbot, firecrawl, jina, searxng,
# ollama-search, duckduckgo; codex is explicit-only). Explicit lists run all
# runnable entries concurrently (max 8; duplicates/unknown/>8 reject before calls).
# Extended backends below are explicit-list only and never automatic.
# PI_SEARCH_WEB_BACKENDS="tavily,exa,brave"
# Extended aliases: parallel, parallel-mcp, tinyfish, querit, valyu, bocha,
# xcrawl, xai, mistral, brightdata, serpapi, serper
# e.g. PI_SEARCH_WEB_BACKENDS="tavily,exa,serper,xcrawl"
# PI_SEARCH_WEB_PROVIDER_TIMEOUT_MS="12000"   # integer 1000..30000
# TAVILY_RESEARCH_MODEL="pro"               # mini|pro|auto, default pro (web_search mode:"agent" streaming report)
# PI_SEARCH_NATIVE_SUMMARIES="1"              # 1/true/0/false, default on
# PI_SEARCH_NATIVE_ANSWERS="1"                # 1/true/0/false, default on
# PI_SEARCH_KG_ENRICHMENT="0"                 # 1/true/0/false, default off
# PI_SEARCH_EXTERNAL_FETCH="0"                # 1/true/0/false, default off
# PI_SEARCH_FETCH_BACKENDS="firecrawl,jina"   # ordered unique subset, max 2
# PI_SEARCH_FETCH_PROVIDER_TIMEOUT_MS="15000" # integer 1000..30000

# ── Codex/ChatGPT web search (optional, auto-detected) ──
# By default Pi-Northstar reads ${CODEX_HOME:-~/.codex}/auth.json from `codex login`.
# Environment credentials override that file.
# CODEX_ACCESS_TOKEN="..."
# CODEX_ACCOUNT_ID="..."
# CODEX_HOME="$HOME/.codex"

# ── Embedding sidecar (powers GitHub code_search semantic retrieval) ──
# When configured, github code_search uses AST-aware embeddings + tree-sitter
# for semantic code retrieval. Without these, code_search falls back to
# lexical GitHub code search.

# EMBEDDING_SIDECAR_PROVIDER="openai"
# EMBEDDING_SIDECAR_BASE_URL="https://api.openai.com/v1"
# EMBEDDING_SIDECAR_API_TOKEN="sk-..."
# EMBEDDING_SIDECAR_DIMENSIONS="1536"
# EMBEDDING_SIDECAR_CODE_MODEL="text-embedding-3-small"

# ── LLM (used by deep research and other LLM-backed features) ──

# SEARCH_LLM_PROVIDER="openai"
# SEARCH_LLM_API_TOKEN="sk-..."
# SEARCH_LLM_BASE_URL="https://api.openai.com/v1"

# ── Deep research ──

# DEEP_RESEARCH_BASE_URL="https://..."
# DEEP_RESEARCH_WORKER_BASE_URL="https://..."
# DEEP_RESEARCH_API_TOKEN="..."
# DEEP_RESEARCH_MODEL="gpt-4o"
# DEEP_RESEARCH_WORKER_MODEL="gpt-4o-mini"

# ── Crawl4AI (alternative page reader backend) ──

# CRAWL4AI_BASE_URL="https://..."
# CRAWL4AI_API_TOKEN="..."

# ── Ollama search (local LLM-backed search) ──

# OLLAMA_SEARCH_BASE_URL="http://localhost:11434"
# OLLAMA_SEARCH_API_KEY="..."

# ── Backend control ──

# PI_SEARCH_WEB_BACKENDS="duckduckgo,brave,searxng"
# PI_SEARCH_BROWSER_ALLOW_SENSITIVE="1"
# PI_SEARCH_DESKTOP_AUTOMATION="1"

# ── User-Chrome companion bridge (optional) ──
# Single multi-companion bridge on literal 127.0.0.1:17319. The extension id
# pins the only allowed companion origin; unset means user-chrome is
# unavailable and the browser tool stays on the isolated backend.
# Selection: Chromium OS-default sole match, or explicit /chrome authorize
# <family> user choice; same-family ambiguity fails closed.
# PI_SEARCH_CHROME_EXTENSION_ID="abcdefghijklmnopqrstuvwxyzabcdef"

# ── Bootstrap ──

# PI_SEARCH_BOOTSTRAP="off"
# PI_SEARCH_AUTO_INSTALL="0"
# PI_SEARCH_ALLOW_INSTALL="0"
# Startup and bare /reach-setup auto never import browser cookies.
# Cookie import/login runs only via explicit /reach-setup import_cookies <provider>
# or /reach-setup login <provider>. Kill switch for explicit paths:
# PI_SEARCH_BROWSER_AUTOMATION="0"

# ── Output ──

# PI_SEARCH_MAX_TOOL_OUTPUT_CHARS="60000"

# ── State ──

# PI_SEARCH_STATE_DIR="$HOME/.pi-northstar"

# ── Cookies ──

# PI_SEARCH_COOKIE_BROWSER="chrome"
# PI_SEARCH_COOKIE_STALE_MS="43200000"

# ── Cookie import via local CDP (explicit /reach-setup import_cookies only) ──

# BROWSER_CDP_ENDPOINT="http://127.0.0.1:9222"

# ── Cua Driver (desktop) ──

# CUA_DRIVER_PATH="/usr/local/bin/cua-driver"

# ── Scrapling (auto-detected if installed) ──
# If scrapling Python package is installed, Pi-Northstar uses it automatically
# for JS-rendered pages and Cloudflare bypass. No config needed.
# Install: pip install "scrapling[fetchers]" && scrapling install
# Optional proxy:
# PI_SEARCH_SCRAPLING_PROXY=
# SIDER_DEVICE=cpu
