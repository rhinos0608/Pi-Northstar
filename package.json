{
  "name": "pi-northstar",
  "version": "0.5.0",
  "description": "Pi extension — web_search, fetch, github, social, kg/graph, browser, desktop, and agent_poll with fused multi-provider search, 12-source research, adaptive agent jobs, and opt-in media/vision acquisition.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "northstar": "bin/northstar.mjs",
    "pi-northstar": "bin/pi-northstar.mjs"
  },
  "files": [
    "bin/",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "src/**/*.ts",
    "artifacts/artifacts.manifest.json",
    "chrome-extension/*.js",
    "chrome-extension/manifest.json",
    "sidecar/*.py",
    "sidecar/requirements.*",
    "README.md",
    "SKILL.md",
    "skills/**/*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:native": "cargo build --release --manifest-path rust/Cargo.toml -p northstar-broker",
    "build:local": "npm run build && npm run build:native",
    "prepack": "npm run build",
    "cli": "node --import tsx src/cli/cli.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "bench:cli-spawn": "node --import tsx bench/cli-spawn-bench.mjs",
    "bench:agent-eval": "node --import tsx bench/agent-eval/run.mjs"
  },
  "dependencies": {
    "@google/genai": "1.52.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "unpdf": "^1.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "typebox": "^1.3.2"
  },
  "optionalDependencies": {
    "agent-browser": "0.37.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^25.6.0",
    "typebox": "^1.3.2",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "keywords": [],
  "author": ""
}
