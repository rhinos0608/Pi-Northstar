{
  "name": "pi-northstar",
  "version": "0.3.0",
  "description": "Pi extension — web search, fetch, GitHub, social, media, browser, and desktop tools with multi-provider search, academic research, and agent-browser automation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pi-northstar": "./bin/pi-northstar.mjs"
  },
  "files": [
    "bin/",
    "src/*.ts",
    "sidecar/",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "agent-browser": "0.37.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.79.10",
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "@types/node": "^25.6.0",
    "typebox": "^1.3.2",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
